<Window x:Class="PCDoctor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Doctor" Width="1120" Height="740" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/><Setter Property="Margin" Value="10,2"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" CornerRadius="9" Padding="14,11" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Checked}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18,14"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Side}"><DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
        <Button Style="{StaticResource Btn}" Content="Switch light / dark" Click="Theme_Click" Margin="0,0,0,8"/>
        <Button Style="{StaticResource Btn}" Content="Check for updates" Click="Update_Click" Margin="0"/>
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="2,10,0,0"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="PC Doctor" FontSize="24" FontWeight="SemiBold" Margin="24,28,0,4"/>
        <TextBlock Text="Diagnose and fix Windows" Foreground="{DynamicResource Muted}" Margin="24,0,0,24"/>
        <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" Content="Dashboard" Tag="Dash" IsChecked="True" Checked="Nav_Checked"/>
        <RadioButton x:Name="NavDrv" Style="{StaticResource Nav}" Content="Drivers" Tag="Drv" Checked="Nav_Checked"/>
        <RadioButton Style="{StaticResource Nav}" Content="Fix Center" Tag="Fix" Checked="Nav_Checked"/>
        <RadioButton Style="{StaticResource Nav}" Content="BIOS" Tag="Bios" Checked="Nav_Checked"/>
        <RadioButton Style="{StaticResource Nav}" Content="Log" Tag="Log" Checked="Nav_Checked"/>
      </StackPanel></DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,12">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="Pages">
        <!-- Dashboard -->
        <Grid x:Name="PageDash">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="24">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,32,0"><TextBlock x:Name="ScoreText" Text="--" FontSize="64" FontWeight="Bold"/><TextBlock x:Name="ScoreLabel" Text="Health score" Foreground="{DynamicResource Muted}"/></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ProgressBar x:Name="ScoreBar" Height="10" Maximum="100" Background="{DynamicResource ButtonBackground}" BorderThickness="0" Margin="0,0,0,18"/>
                <WrapPanel>
                  <Button Style="{StaticResource Btn}" Content="Scan system" Click="Scan_Click" Margin="0,0,8,8"/>
                  <Button Style="{StaticResource Primary}" Content="One-click: scan and install drivers" Click="OneClick_Click" Margin="0,0,8,8"/>
                  <Button Style="{StaticResource Btn}" Content="Export PDF report" Click="Export_Click" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="FindingsList"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse Width="12" Height="12" Fill="{Binding Dot}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding Check}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Advice}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Result}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
        <!-- Drivers -->
        <Grid x:Name="PageDrv" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource Btn}" Content="Search for drivers" Click="Search_Click"/>
            <Button Style="{StaticResource Primary}" Content="Install selected" Click="Install_Click"/>
            <Button Style="{StaticResource Btn}" Content="Back up drivers" Click="Backup_Click"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1"><ItemsControl x:Name="DriversList"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}"><StackPanel Orientation="Horizontal">
              <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"/>
              <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Info}" Foreground="{DynamicResource Muted}" FontSize="12.5"/></StackPanel>
            </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
        <!-- Fix Center -->
        <Grid x:Name="PageFix" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ProblemBox" Background="Transparent" Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center" KeyDown="Problem_KeyDown"/>
            <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Find a fix" Margin="12,0,0,0" Click="Find_Click"/>
          </Grid></Border>
          <ScrollViewer Grid.Row="1"><ItemsControl x:Name="FixList"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}"><StackPanel Orientation="Horizontal">
              <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"/>
              <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Desc}" Foreground="{DynamicResource Muted}" FontSize="12.5"/></StackPanel>
            </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource Primary}" Content="Run selected fixes" Click="RunFix_Click"/>
            <Button Style="{StaticResource Btn}" Content="Undo (System Restore)" Click="Undo_Click"/>
            <Button Style="{StaticResource Btn}" Content="Copy redacted report" Click="Share_Click"/>
          </StackPanel>
        </Grid>
        <!-- BIOS -->
        <Grid x:Name="PageBios" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,16">
            <Button Style="{StaticResource Primary}" Content="Read BIOS settings" Click="BiosRead_Click" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" Content="Install vendor update tool" Click="VendorTool_Click" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" Content="Vendor support page" Click="VendorWeb_Click" Margin="0,0,8,8"/>
          </WrapPanel>
          <ScrollViewer Grid.Row="1"><ItemsControl x:Name="BiosList"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse Width="12" Height="12" Fill="{Binding Dot}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Info}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap"/></StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="12,0"/>
              <Button Grid.Column="3" Style="{StaticResource Primary}" Content="Enable" Tag="{Binding}" Visibility="{Binding CanEnable}" Click="BiosEnable_Click" Margin="0"/>
            </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
        <!-- Log -->
        <Border x:Name="PageLog" Style="{StaticResource Card}" Visibility="Collapsed">
          <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource Fg2}" BorderThickness="0" FontFamily="Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Border>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,6,0,0">
        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
        <TextBlock x:Name="StatusText" Text="Ready." Foreground="{DynamicResource Muted}" FontSize="12.5"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
